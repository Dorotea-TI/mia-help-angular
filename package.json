{
  "name": "mia-help-angular",
  "version": "21.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve example",
    "build": "ng build example",
    "watch": "ng build example --watch --configuration development",
    "build:core": "ng build @doroteati/mia-help-core --configuration production",
    "build:editor": "ng build @doroteati/mia-help-editor --configuration production",
    "build:viewer": "ng build @doroteati/mia-help-viewer --configuration production",
    "build:libs": "npm run build:core && npm run build:editor && npm run build:viewer",
    "publish:core": "npm run build:core && npm publish ./dist/doroteati/mia-help-core --access public",
    "publish:editor": "npm run build:editor && npm publish ./dist/doroteati/mia-help-editor --access public",
    "publish:viewer": "npm run build:viewer && npm publish ./dist/doroteati/mia-help-viewer --access public",
    "publish:libs": "npm run publish:core && npm run publish:editor && npm run publish:viewer",
    "test": "ng test",
    "serve:ssr:example": "node dist/example/server/server.mjs",
    "build:ssr:example": "ng build example --configuration production"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.1",
    "@angular/cdk": "^21.2.1",
    "@angular/common": "^21.2.1",
    "@angular/compiler": "^21.2.1",
    "@angular/core": "^21.2.1",
    "@angular/forms": "^21.2.1",
    "@angular/material": "^21.2.1",
    "@angular/material-moment-adapter": "^21.2.1",
    "@angular/platform-browser": "^21.2.1",
    "@angular/platform-browser-dynamic": "^21.2.1",
    "@angular/platform-server": "^21.2.1",
    "@angular/router": "^21.2.1",
    "@angular/ssr": "^21.2.1",
    "@doroteati/mia-auth": "^21.0.1",
    "@doroteati/mia-category-core": "^21.0.1",
    "@doroteati/mia-category-editor": "^21.0.1",
    "@doroteati/mia-core": "^21.0.0",
    "@doroteati/mia-form": "^21.0.3",
    "@doroteati/mia-language-core": "^21.0.0",
    "@doroteati/mia-layout": "^21.1.0",
    "@doroteati/mia-loading": "^21.0.0",
    "@doroteati/mia-table": "^21.1.0",
    "@ngx-pwa/local-storage": "^21.0.0",
    "dayjs": "^1.11.19",
    "express": "^5.1.0",
    "moment": "^2.30.1",
    "ngx-currency": "^19.0.0",
    "ngx-quill": "^30.0.1",
    "parchment": "^3.0.0",
    "quill": "^2.0.3",
    "rxjs": "^7.8.2",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.1",
    "@angular/cli": "^21.2.1",
    "@angular/compiler-cli": "^21.2.1",
    "@types/express": "^5.0.1",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^25.3.5",
    "jasmine-core": "^6.1.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "ng-packagr": "^21.2.0",
    "typescript": "~5.9.3"
  }
}
