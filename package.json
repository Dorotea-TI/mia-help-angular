{
  "name": "mia-help-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "build2": "ng build --configuration production --project=@doroteati/mia-help-core && cd dist/doroteati/mia-help-core/ && npm publish --access public",
    "build3": "ng build --configuration production --project=@doroteati/mia-help-editor && cd dist/doroteati/mia-help-editor/ && npm publish --access public",
    "build4": "ng build --configuration production --project=@doroteati/mia-help-viewer && cd dist/doroteati/mia-help-viewer/ && npm publish --access public",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.12",
    "@angular/cdk": "^16.2.14",
    "@angular/common": "^17.3.12",
    "@angular/compiler": "^17.3.12",
    "@angular/core": "^17.3.12",
    "@angular/forms": "^17.3.12",
    "@angular/material": "^16.2.14",
    "@angular/material-moment-adapter": "^16.2.14",
    "@angular/platform-browser": "^17.3.12",
    "@angular/platform-browser-dynamic": "^17.3.12",
    "@angular/router": "^17.3.12",
    "moment": "^2.29.1",
    "ngx-quill": "^22.0.0",
    "quill": "^1.3.7",
    "quill-image-resize": "^3.0.9",
    "quill-image-resize-module": "^3.0.0",
    "rxjs": "~7.4.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.16",
    "@angular/cli": "^17.3.16",
    "@angular/compiler-cli": "^17.3.12",
    "@types/jasmine": "~3.8.0",
    "@types/node": "^12.11.1",
    "@types/quill": "^1.3.10",
    "jasmine-core": "~3.8.0",
    "karma": "~6.3.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.0.3",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "~1.7.0",
    "ng-packagr": "^17.3.0",
    "typescript": "~5.4.5"
  }
}
