{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "cli": {
    "analytics": "c24e440d-4ab5-4773-b1af-d993d1d4bd78"
  },
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "@doroteati/mia-help-core": {
      "projectType": "library",
      "root": "projects/doroteati/mia-help-core",
      "sourceRoot": "projects/doroteati/mia-help-core/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/doroteati/mia-help-core/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/doroteati/mia-help-core/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/doroteati/mia-help-core/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "main": "projects/doroteati/mia-help-core/src/test.ts",
            "tsConfig": "projects/doroteati/mia-help-core/tsconfig.spec.json",
            "karmaConfig": "projects/doroteati/mia-help-core/karma.conf.js"
          }
        }
      }
    },
    "@doroteati/mia-help-editor": {
      "projectType": "library",
      "root": "projects/doroteati/mia-help-editor",
      "sourceRoot": "projects/doroteati/mia-help-editor/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/doroteati/mia-help-editor/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/doroteati/mia-help-editor/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/doroteati/mia-help-editor/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "main": "projects/doroteati/mia-help-editor/src/test.ts",
            "tsConfig": "projects/doroteati/mia-help-editor/tsconfig.spec.json",
            "karmaConfig": "projects/doroteati/mia-help-editor/karma.conf.js"
          }
        }
      }
    },
    "example": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        },
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "projects/example",
      "sourceRoot": "projects/example/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist/example"
            },
            "index": "projects/example/src/index.html",
            "polyfills": [
              "projects/example/src/polyfills.ts"
            ],
            "tsConfig": "projects/example/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/example/src/favicon.ico",
              "projects/example/src/assets"
            ],
            "styles": [
              "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
              "projects/example/src/styles.scss"
            ],
            "allowedCommonJsDependencies": [
              "moment",
              "quill-delta"
            ],
            "scripts": [],
            "browser": "projects/example/src/main.ts",
            "server": "projects/example/src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": [
                "localhost",
                "127.0.0.1"
              ]
            },
            "ssr": {
              "entry": "projects/example/src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1900kb",
                  "maximumError": "2200kb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "3kb",
                  "maximumError": "5kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "projects/example/src/environments/environment.ts",
                  "with": "projects/example/src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "example:build:production"
            },
            "development": {
              "buildTarget": "example:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "example:build"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "main": "projects/example/src/test.ts",
            "polyfills": "projects/example/src/polyfills.ts",
            "tsConfig": "projects/example/tsconfig.spec.json",
            "karmaConfig": "projects/example/karma.conf.js",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/example/src/favicon.ico",
              "projects/example/src/assets"
            ],
            "styles": [
              "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
              "projects/example/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    },
    "@doroteati/mia-help-viewer": {
      "projectType": "library",
      "root": "projects/doroteati/mia-help-viewer",
      "sourceRoot": "projects/doroteati/mia-help-viewer/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/doroteati/mia-help-viewer/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/doroteati/mia-help-viewer/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/doroteati/mia-help-viewer/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "main": "projects/doroteati/mia-help-viewer/src/test.ts",
            "tsConfig": "projects/doroteati/mia-help-viewer/tsconfig.spec.json",
            "karmaConfig": "projects/doroteati/mia-help-viewer/karma.conf.js"
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
